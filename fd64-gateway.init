#!/bin/sh
# /etc/init.d/fd64-gateway — SysV init script for fd64-gateway
# Install: cp fd64-gateway.init /etc/init.d/fd64-gateway && chmod +x /etc/init.d/fd64-gateway
# Enable:  ln -s ../init.d/fd64-gateway /etc/rc.d/S50fd64-gateway

DAEMON=/mnt/sda2/YaYOS/fd64-gateway/gateway.py
# fatdog64-style /aufs stacking fallback (cross-distro)
[ -f "$DAEMON" ] || DAEMON=/aufs/devbase/fd64-gateway/gateway.py
PIDFILE=/run/fd64-gateway.pid
LOGFILE=/var/log/fd64-gateway.log
PYTHON=/usr/bin/python3

start() {
    echo "Starting fd64-gateway..."
    "$PYTHON" "$DAEMON" --pidfile "$PIDFILE" >> "$LOGFILE" 2>&1 &
    echo "fd64-gateway started (port 8772)"
}

stop() {
    echo "Stopping fd64-gateway..."
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null && rm -f "$PIDFILE"
    else
        pkill -f fd64-gateway/gateway.py
    fi
}

status() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "fd64-gateway is running (pid $(cat "$PIDFILE"))"
    else
        echo "fd64-gateway is not running"
    fi
}

case "$1" in
    start)   start   ;;
    stop)    stop    ;;
    restart) stop; start ;;
    status)  status  ;;
    *)       echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
